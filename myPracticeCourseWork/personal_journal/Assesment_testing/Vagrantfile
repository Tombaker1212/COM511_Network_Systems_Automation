Vagrant.configure("2") do |config|

  config.vm.box = "ubuntu/jammy64"

  # =====================
  # MGMT SERVER
  # =====================

  config.vm.define "mgmt" do |mgmt|

    mgmt.vm.hostname = "mgmt"
    mgmt.vm.network "private_network", ip: "192.168.56.10"

    mgmt.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
    end

    mgmt.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y ansible git

      sudo -u vagrant mkdir -p /home/vagrant/sirius

      cat > /home/vagrant/sirius/inventory.yml <<EOF
all:
  hosts:
    branch1:
      ansible_host: 192.168.56.11

    branch2:
      ansible_host: 192.168.56.12
EOF

      chown -R vagrant:vagrant /home/vagrant/sirius
    SHELL

  end

  # =====================
  # BRANCH1
  # =====================

  config.vm.define "branch1" do |node|

    node.vm.hostname = "branch1"
    node.vm.network "private_network", ip: "192.168.56.11"

    node.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end

  end

  # =====================
  # BRANCH2
  # =====================

  config.vm.define "branch2" do |node|

    node.vm.hostname = "branch2"
    node.vm.network "private_network", ip: "192.168.56.12"

    node.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
    end

  end

end